{
  "name": "nico-live-recorder",
  "version": "0.5.1",
  "description": "ニコニコ生放送の放送開始を検知して自動録画するデスクトップアプリ",
  "main": "./out/main/index.js",
  "author": "honishi",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "icons:build": "node scripts/icons/build.mjs",
    "ffmpeg:build": "node scripts/ffmpeg/build.mjs",
    "ffmpeg:verify": "node --import tsx scripts/ffmpeg/verify.mjs",
    "ffmpeg:verify-artifacts": "node scripts/ffmpeg/verify-artifacts.mjs"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "electron-updater": "6.8.9",
    "protobufjs": "^8.8.0",
    "set-cookie-parser": "^3.1.2",
    "undici": "^8.10.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/set-cookie-parser": "^2.4.10",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "26.16.0",
    "electron-vite": "^5.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jpeg-js": "0.4.4",
    "js-yaml": "4.3.2",
    "prettier": "^3.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "protobufjs@7.6.5": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "fsevents": false
  }
}
